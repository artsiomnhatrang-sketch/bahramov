{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/session-context.sh",
            "timeout": 15,
            "statusMessage": "Загружаю контекст проекта"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__claude-in-chrome__computer|mcp__claude-in-chrome__form_input|mcp__claude-in-chrome__javascript_tool|mcp__Claude_Browser__computer|mcp__Claude_Browser__form_input|mcp__Claude_Browser__javascript_tool",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/voice-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
